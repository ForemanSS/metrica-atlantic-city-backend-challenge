  },

  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "atlanticcity"
  },

  "Jwt": {
    "Issuer": "AtlanticCity.Authentication",
    "Audience": "AtlanticCity.Api"
  }
}