{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "MassTransit": "Information"
    }
  },

  "AllowedHosts": "*",

  "LoadUpload": {
    "MaxFileSizeBytes": 20971520
  },

  "SeaweedFs": {
