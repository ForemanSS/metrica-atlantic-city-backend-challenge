{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },

  "AllowedHosts": "*",

  "ReverseProxy": {
    "Routes": {
      "authentication-route": {
        "ClusterId": "authentication-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/auth/{**catch-all}"
        }
      },

      "control-load-upload-route": {
        "ClusterId": "control-cluster",
        "AuthorizationPolicy": "MassLoadExecute",
        "Match": {
          "Path": "/api/loads",
          "Methods": [
            "POST"
          ]
        }
      },

      "control-load-read-route": {
        "ClusterId": "control-cluster",
        "AuthorizationPolicy": "MassLoadRead",
        "Match": {
          "Path": "/api/loads/{**catch-all}",
          "Methods": [
            "GET"
          ]
        }
      }
    },

    "Clusters": {
      "authentication-cluster": {
        "Destinations": {
          "authentication-api": {
            "Address": "http://localhost:5149/"
          }
        }
      },

      "control-cluster": {
        "Destinations": {
          "control-api": {
            "Address": "http://localhost:5112/"
          }
        }
      }
    }
  }
}